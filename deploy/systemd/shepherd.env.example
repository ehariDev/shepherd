# Example /etc/shepherd/shepherd.env for the systemd service
# (shepherd.service's EnvironmentFile=). Holds every secret Shepherd needs --
# never put these in shepherd.yaml.example, which the shepherd GROUP can
# read.
#
# Install at /etc/shepherd/shepherd.env, owned root:shepherd, mode 0640:
#   install -o root -g shepherd -m 0640 shepherd.env.example /etc/shepherd/shepherd.env

# Required. postgresql://user:password@host:port/dbname -- see the Database
# docs page for CloudNativePG-equivalent guidance on a bare host (there
# isn't one; point this at a PostgreSQL 16 you run yourself, per the Linux
# service docs page's install steps).
SHEPHERD_DATABASE_URL=postgres://shepherd:CHANGE_ME@127.0.0.1:5432/shepherd?sslmode=require

# Required. Base64-encoded 32-byte key encrypting stored credentials
# (git provider tokens, the OIDC client secret) at rest. Generate once:
#   openssl rand -base64 32
# KEEP IT. A replacement key cannot decrypt what the old one wrote, and
# there is no way to recover a lost one -- back it up wherever you back up
# this host's other secrets.
SHEPHERD_SECURITY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Recommended. Password for the administrator account created on first
# boot (read only while the users table is empty -- a later change here has
# no effect). Leave unset and the account is admin/admin, forced to change
# its password before it can do anything.
SHEPHERD_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
